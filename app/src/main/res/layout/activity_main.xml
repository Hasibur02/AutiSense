<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection System"
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:gravity="center"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Learning-Based Facial Image Analysis"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginTop="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RegNetY-800MF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="#E8F0FE" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MAIN CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:padding="20dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select or Capture a Facial Image"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:gravity="center"
                android:layout_marginBottom="7dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose an image from your gallery or capture a new facial image using the camera."
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#64748B"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="18dp" />


            <!-- ================================================= -->
            <!-- UPLOAD + CAMERA OPTIONS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">


                <!-- ================================================= -->
                <!-- UPLOAD CARD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="155dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F8FAFC"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:tint="#2563EB"
                        android:contentDescription="Upload image icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Image"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#172033"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="From Gallery"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/galleryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Gallery"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:textColor="#2563EB"
                        android:backgroundTint="#E8F0FE"
                        android:layout_marginTop="7dp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- CAMERA CARD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="155dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F8FAFC"
                    android:padding="10dp"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:tint="#2563EB"
                        android:contentDescription="Camera icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Camera"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#172033"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take a Photo"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:textColor="#64748B"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/cameraButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Camera"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:textColor="#2563EB"
                        android:backgroundTint="#E8F0FE"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INSTRUCTION -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select an image or capture a new one to begin."
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginTop="18dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CAMERA PREVIEW -->
        <!-- ================================================= -->

        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:background="#172033"
            android:elevation="5dp">


            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#172033"
                android:scaleType="fitCenter" />


            <!-- CAMERA GUIDE -->

            <TextView
                android:id="@+id/cameraGuideText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Position your face inside the frame"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="#66000000" />

        </FrameLayout>


        <!-- ================================================= -->
        <!-- CAMERA CONTROLS -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/switchCameraButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="↔  Switch Camera"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:backgroundTint="#E8F0FE"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />


        <Button
            android:id="@+id/captureButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Capture Photo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:elevation="3dp" />


        <!-- ================================================= -->
        <!-- SELECTED IMAGE CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/selectedImageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected Image"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/selectedImage"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:background="#E2E8F0"
                android:contentDescription="Selected facial image" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PREDICT BUTTON -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/predictButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Predict ASD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#172033"
            android:elevation="4dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />


        <!-- ================================================= -->
        <!-- PROGRESS -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp" />


        <!-- ================================================= -->
        <!-- STATUS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready for image analysis."
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="#64748B"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="26dp" />


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:background="#CBD5E1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection using RegNetY-800MF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-Based Research Project"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Learning • Computer Vision • Explainable AI"
                android:textSize="11sp"
                android:textColor="#A0AEC0"
                android:gravity="center"
                android:layout_marginTop="5dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
