<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASD Detection System"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="@color/cyan"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Learning-Based Facial Image Analysis"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RegNetY-800MF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@drawable/bg_badge"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- MAIN CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select or Capture a Facial Image"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose an image from your gallery or capture a new facial image using the camera."
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp" />

            <!-- OPTIONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- GALLERY -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_option"
                    android:paddingTop="12dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="5dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Gallery" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Image"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="From Gallery"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/galleryButton"
                        android:layout_width="130dp"
                        android:layout_height="45dp"
                        android:text="Gallery"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:textColor="#172033"
                        android:background="@drawable/bg_orange_button"
                        android:backgroundTint="#F7C89F"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <!-- CAMERA -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_option"
                    android:paddingTop="12dp"
                    android:paddingBottom="10dp"
                    android:layout_marginStart="5dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:contentDescription="Camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Camera"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take a Photo"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/cameraButton"
                        android:layout_width="130dp"
                        android:layout_height="45dp"
                        android:text="Camera"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        android:background="@drawable/bg_orange_button"
                        android:backgroundTint="@null"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select an image or capture a new one to begin."
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- SELECTED IMAGE -->

        <FrameLayout
            android:id="@+id/selectedImageContainer"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/selectedImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Selected facial image" />

        </FrameLayout>

        <!-- CAMERA -->

        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/black"
            android:visibility="gone"
            android:elevation="3dp"
            android:layout_marginBottom="10dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:layout_width="210dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_camera_frame" />

        </FrameLayout>

        <!-- CAMERA ACTIONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/captureButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Capture"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:background="@drawable/bg_orange_button"
                android:backgroundTint="@null"
                android:visibility="gone"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/switchCameraButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Switch Camera"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:background="@drawable/bg_orange_button"
                android:backgroundTint="@null"
                android:visibility="gone"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- RESULT STATUS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analysis Status"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready for image analysis."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:textStyle="italic"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="4dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <!-- PREDICT -->

        <Button
            android:id="@+id/predictButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Predict Result"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:background="@drawable/bg_orange_button"
            android:backgroundTint="@null"
            android:elevation="3dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <!-- FOOTER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:background="@color/cyan"
                android:layout_marginBottom="7dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection using RegNetY-800MF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-Based Research Project"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Learning • Computer Vision • Explainable AI"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>