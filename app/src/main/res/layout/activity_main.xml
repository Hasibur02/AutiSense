<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- Header -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection System"
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Learning-Based Facial Image Analysis"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Section Header -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload or Capture Image"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload a facial image or use your camera for ASD prediction."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />


        <!-- ================================================= -->
        <!-- Camera Preview -->
        <!-- ================================================= -->

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:visibility="gone"
            android:background="#172033"
            android:layout_marginBottom="12dp" />


        <!-- ================================================= -->
        <!-- Switch Camera -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/switchCameraButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="↔ Switch Camera"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:backgroundTint="#E8F0FE"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />


        <!-- ================================================= -->
        <!-- Capture Button -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/captureButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Capture Photo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />


        <!-- ================================================= -->
        <!-- Upload + Camera Cards -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">


            <!-- ================================================= -->
            <!-- Upload Image Card -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:padding="14dp"
                android:layout_marginEnd="7dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:tint="#2563EB"
                    android:contentDescription="Upload image icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload Image"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#172033"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/galleryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Gallery"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="#2563EB"
                    android:backgroundTint="#E8F0FE"
                    android:layout_marginTop="6dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- Open Camera Card -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:padding="14dp"
                android:layout_marginStart="7dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="#2563EB"
                    android:contentDescription="Camera icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Camera"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#172033"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/cameraButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Camera"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="#2563EB"
                    android:backgroundTint="#E8F0FE"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Selected Image -->
        <!-- IMPORTANT: Hidden until image selected/captured -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/selectedImage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:background="#E2E8F0"
            android:contentDescription="Selected facial image"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />


        <!-- ================================================= -->
        <!-- Predict Button -->
        <!-- IMPORTANT: Appears only after image is available -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/predictButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Predict ASD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#172033"
            android:elevation="4dp"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />


        <!-- ================================================= -->
        <!-- Progress -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="18dp" />


        <!-- ================================================= -->
        <!-- Status -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload or capture an image to begin."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="28dp" />


        <!-- ================================================= -->
        <!-- Footer -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:background="#CBD5E1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection using RegNetY-800MF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-Based Research Project"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>