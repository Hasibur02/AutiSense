<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection Result"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-assisted facial image analysis"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- RESULT CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prediction"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/predictionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASD"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:gravity="center" />

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confidence: 95.00%"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:gravity="center"
                android:layout_marginTop="10dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PROBABILITY TITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prediction Probability"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:layout_marginBottom="12dp" />


        <!-- ================================================= -->
        <!-- ASD PROBABILITY CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="17dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ASD Probability"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#374151" />

                <TextView
                    android:id="@+id/asdProbabilityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/asdProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#EF4444"
                android:layout_marginTop="11dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- NON ASD PROBABILITY CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="17dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Non-ASD Probability"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#374151" />

                <TextView
                    android:id="@+id/nonAsdProbabilityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/nonAsdProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#3B82F6"
                android:layout_marginTop="11dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ORIGINAL IMAGE SECTION -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Original Image"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:layout_marginBottom="11dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="12dp"
            android:layout_marginBottom="25dp">

            <ImageView
                android:id="@+id/originalImage"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:background="#E2E8F0"
                android:contentDescription="Original facial image" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- EXPLAINABLE AI -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explainable AI"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grad-CAM highlights the facial regions that contributed most to the model's prediction."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="15dp" />


        <!-- ================================================= -->
        <!-- GRAD-CAM IMAGES -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="25dp">


            <!-- HEATMAP -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:padding="10dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Heatmap"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/heatmapImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="#E2E8F0"
                    android:contentDescription="Grad-CAM heatmap" />

            </LinearLayout>


            <!-- OVERLAY -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:padding="10dp"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overlay"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/gradcamImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="#E2E8F0"
                    android:contentDescription="Grad-CAM overlay" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- IMPORTANT NOTICE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFF7ED"
            android:padding="15dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Important Notice"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#9A3412"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ Screening result only — not a medical diagnosis."
                android:textSize="12sp"
                android:textColor="#7C2D12"
                android:gravity="center" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ACTION BUTTONS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="25dp">

            <Button
                android:id="@+id/saveResultButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="↓ Save Result"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#172033"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Another Image"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                android:backgroundTint="#E8F0FE"
                android:layout_marginStart="6dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="20dp">

            <View
                android:layout_width="55dp"
                android:layout_height="2dp"
                android:background="#CBD5E1"
                android:layout_marginBottom="11dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection using RegNetY-800MF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-Based Research Project"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>