<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection Result"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/cyan"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-assisted facial image analysis"
                android:textSize="14sp"
                android:textColor="@color/header_subtitle"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RegNetY-800MF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_navy"
                android:background="@drawable/bg_primary_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="9dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- RESULT CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:padding="22dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prediction"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/predictionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASD"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confidence: 95.00%"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_navy"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PROBABILITY TITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prediction Probability"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/cyan"
            android:layout_marginBottom="10dp" />


        <!-- ================================================= -->
        <!-- ASD PROBABILITY CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:padding="16dp"
            android:layout_marginBottom="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ASD Probability"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/asdProbabilityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/asd_color" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/asdProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/asd_color"
                android:layout_marginTop="10dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- NON ASD PROBABILITY CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Non-ASD Probability"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/nonAsdProbabilityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/non_asd_color" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/nonAsdProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/non_asd_color"
                android:layout_marginTop="10dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ORIGINAL IMAGE SECTION -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Original Image"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/cyan"
            android:layout_marginBottom="9dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:padding="10dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/originalImage"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:background="#7E9695"
                android:contentDescription="Original facial image" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- EXPLAINABLE AI -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explainable AI"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/cyan"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grad-CAM highlights the facial regions that contributed most to the model's prediction."
            android:textSize="14sp"
            android:textColor="@color/header_subtitle"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />


        <!-- ================================================= -->
        <!-- GRAD-CAM IMAGES -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">


            <!-- HEATMAP -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="9dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Heatmap"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="7dp" />

                <ImageView
                    android:id="@+id/heatmapImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="#7E9695"
                    android:contentDescription="Grad-CAM heatmap" />

            </LinearLayout>


            <!-- OVERLAY -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="9dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overlay"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="7dp" />

                <ImageView
                    android:id="@+id/gradcamImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="#7E9695"
                    android:contentDescription="Grad-CAM overlay" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- IMPORTANT NOTICE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_notice"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Important Notice"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/notice_text"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ Screening result only — not a medical diagnosis."
                android:textSize="12sp"
                android:textColor="@color/notice_text"
                android:gravity="center" />


        </LinearLayout>


        <!-- ================================================= -->
        <!-- ACTION BUTTONS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/saveResultButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="↓ Save Result"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/primary_navy"
                android:background="@drawable/bg_primary_button"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Another Image"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/primary_navy"
                android:background="@drawable/bg_primary_button"
                android:layout_marginStart="5dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="18dp">

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="#F7C89F"
                android:layout_marginBottom="9dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASD Detection using RegNetY-800MF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/header_text"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-Based Research Project"
                android:textSize="12sp"
                android:textColor="@color/header_subtitle"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Learning • Computer Vision • Explainable AI"
                android:textSize="11sp"
                android:textColor="@color/header_subtitle"
                android:gravity="center"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>